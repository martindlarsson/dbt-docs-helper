{
  "name": "dbt-docs-helper-cli",
  "version": "0.1.0",
  "description": "Coverage, inheritance and docs-block checks for dbt documentation, from the terminal or CI.",
  "license": "MIT",
  "bin": {
    "dbt-docs-helper": "dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "repository": {
    "type": "git",
