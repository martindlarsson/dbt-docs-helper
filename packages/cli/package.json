    "directory": "packages/cli"
  },
  "keywords": ["dbt", "documentation", "coverage", "fusion"],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node18 --outfile=dist/cli.js"
  },
  "devDependencies": {
    "@dbt-docs-helper/core": "0.1.0"
  }
}
