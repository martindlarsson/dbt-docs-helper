{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run extension on the fixture project",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode", "${workspaceFolder}/fixtures/jaffle"],
